{
  "name": "cc-trade",
  "private": true,
  "version": "0.5.1",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "tisovy",
  "license": "GPL-3.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      "!**/*.map",
      "!**/.env{,.*}"
    ],
    "afterPack": "./scripts/check-packaged-app.mjs"
  },
  "scripts": {
    "e": "PORT=5174 VITE_DEV_SERVER_URL=http://localhost:5174 vite",
    "e:safe": "BUILD_MODE=safe-dev PORT=5174 VITE_DEV_SERVER_URL=http://localhost:5174 vite",
    "e:smoke": "BUILD_MODE=smoke PORT=5174 VITE_DEV_SERVER_URL=http://localhost:5174 vite",
    "dev": "vite --port 5174",
    "start": "vite --port 5174",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "prebuild": "npm run clean:build",
    "build": "vite build",
    "postbuild": "npm run check:electron-build-artifacts",
    "predist": "npm run build",
    "dist": "electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:futures-burst": "vitest run src/App.futures-burst.test.jsx",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "npm run check:dependency-baseline && npm run test && npm run lint && npm run build && npm run check:circular && npm run check:runtime-mock && npm run check:futures-production && npm run check:command-path",
    "check:dependency-baseline": "node scripts/check-dependency-baseline.mjs",
    "check:circular": "node scripts/check-circular-imports.mjs",
    "check:electron-build-artifacts": "node scripts/check-electron-build-artifacts.mjs",
    "check:packaged-app": "node scripts/check-packaged-app.mjs",
    "check:runtime-mock": "node scripts/check-runtime-mock-layer.mjs",
    "check:futures-production": "node scripts/check-futures-workstation-boundaries.mjs",
    "check:command-path": "node scripts/check-trading-command-path.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@binance/common": "^2.0.1",
    "@binance/spot": "^24.0.0",
    "d3-format": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "https-proxy-agent": "^7.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socks-proxy-agent": "^8.0.5",
    "technicalindicators": "^3.1.0",
    "websocket": "^1.0.35",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "bootstrap": "^5.3.8",
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "lightweight-charts": "^5.0.9",
    "react-bootstrap": "^2.10.10",
    "sass": "^1.94.1",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.11"
  }
}
